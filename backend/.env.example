# Copy to .env and adjust values for your local environment.
PROJECT_NAME=GRAMPay API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=grampay
POSTGRES_PASSWORD=change-me
POSTGRES_DB=grampay

# Optional full connection string override.
# DATABASE_URL=postgresql+psycopg://grampay:change-me@localhost:5432/grampay

# Change this before deploying anywhere shared.
SECRET_KEY=change-this-development-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Seeded demo wallet values (INR).
DEMO_CUSTOMER_BALANCE=2500.00
DEMO_MERCHANT_BALANCE=0.00
DEMO_OFFLINE_SPENDING_LIMIT=500.00
REGISTRATION_BALANCE=1000.00
DEMO_ACCOUNT_PASSWORD=Demo@1234
