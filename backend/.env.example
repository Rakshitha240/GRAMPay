# Copy to .env and adjust values for your local environment.
PROJECT_NAME=GRAMPay API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=grampay
POSTGRES_PASSWORD=change-me
POSTGRES_DB=grampay

# Optional full connection string override.
# DATABASE_URL=postgresql+psycopg://grampay:change-me@localhost:5432/grampay
